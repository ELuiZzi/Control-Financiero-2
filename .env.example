# Copia este archivo como .env y llena los valores de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → App web).
# Si se dejan vacíos, la app funciona solo en este dispositivo, como antes.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Solo para desarrollo/pruebas con los emuladores locales de Firebase
# VITE_FIREBASE_EMULATORS=true
